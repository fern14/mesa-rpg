# Copie para .env e preencha com a configuração do app Web no console Firebase.
# São identificadores públicos. Nunca coloque chaves de conta de serviço no app.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_SITE_URL=https://fern14.github.io/mesa-rpg/
# Somente para testes locais; use o IP do computador ao testar em um celular.
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
